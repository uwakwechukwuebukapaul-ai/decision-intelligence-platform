from datetime import datetime



class StrategyRecommender:



    def recommend(

        self,

        question,

        investment_score,

        market_signal

    ):


        if investment_score >= 75:


            strategy = [

                "Build AI-native SOC investigation platform",

                "Focus on autonomous alert investigation",

                "Target organizations suffering from analyst overload",

                "Differentiate through AI reasoning and automation"

            ]


            recommendation = (

                "Execute AI SOC automation market entry strategy"

            )


        else:


            strategy = [

                "Collect additional market intelligence",

                "Validate customer demand",

                "Reduce execution risk"

            ]


            recommendation = (

                "Delay aggressive investment"

            )



        return {


            "question":

                question,


            "recommendation":

                recommendation,


            "strategy":

                strategy,


            "market_signal":

                market_signal,


            "timestamp":

                datetime.utcnow().isoformat()

        }